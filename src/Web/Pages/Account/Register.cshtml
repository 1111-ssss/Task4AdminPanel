@page
@model Account.RegisterModel
@{
    ViewData["Title"] = "Sign Up";
    Layout = "_AuthLayout";
}

<h1 class="fw-bold mb-4" style="color:#0d6efd;">THE APP</h1>
<p class="text-muted mb-1">Start your journey</p>
<h2 class="mb-4">Sign Up</h2>

<form id="registerForm" method="post" class="w-100" style="max-width: 400px;">
    <div class="mb-3">
        <label asp-for="Input.Email" class="form-label"></label>
        <input asp-for="Input.Email" class="form-control" placeholder="example@email.com" />
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.Name" class="form-label"></label>
        <input asp-for="Input.Name" class="form-control" placeholder="John" />
        <span asp-validation-for="Input.Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.Surname" class="form-label"></label>
        <input asp-for="Input.Surname" class="form-control" placeholder="Doe" />
        <span asp-validation-for="Input.Surname" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.Password" class="form-label"></label>
        <input asp-for="Input.Password" class="form-control" />
        <span asp-validation-for="Input.Password" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.ConfirmPassword" class="form-label"></label>
        <input asp-for="Input.ConfirmPassword" class="form-control" />
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary w-100 py-2" id="registerBtn">
        <span id="btnText">Sign up</span>
        <span id="btnSpinner" class="spinner-border spinner-border-sm d-none" role="status"></span>
    </button>
</form>

<div class="d-flex justify-content-between w-100 mt-4" style="max-width: 400px;">
    <a href="/Account/Login">Already have an account? Sign in</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/register.js"></script>
}